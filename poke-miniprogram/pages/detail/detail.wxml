<view wx:if="{{loading}}" class="detail-page">
  <view class="detail-nav" style="padding-top:{{statusBarHeight}}px">
    <view class="detail-nav-back" bindtap="onBack">‹ 返回</view>
  </view>
  <view class="detail-hero-skeleton skeleton-block"></view>
  <view class="wrap detail-body">
    <view class="skeleton-line w60"></view>
    <view class="skeleton-line w90"></view>
    <view class="skeleton-line w80"></view>
    <view class="skeleton-card"></view>
    <view class="skeleton-card"></view>
  </view>
</view>

<view wx:elif="{{item}}" class="detail-page {{ready ? 'detail-ready' : ''}}">
  <view class="detail-nav detail-nav-overlay" style="padding-top:{{statusBarHeight}}px">
    <view class="detail-nav-back" bindtap="onBack">‹ 返回</view>
  </view>
  <view class="detail-hero">
    <image
      class="detail-cover {{coverLoaded ? 'cover-loaded' : ''}}"
      src="{{item.coverSrc}}"
      mode="aspectFill"
      bindload="onCoverLoad"
    />
    <view class="detail-hero-mask"></view>
    <view wx:if="{{item.deadline}}" class="detail-deadline-badge {{item.deadlineUrgent ? 'urgent' : ''}}">
      {{item.deadline}}
    </view>
  </view>

  <view class="wrap detail-body detail-pad-bottom">
    <view class="detail-block detail-enter d0">
      <view class="chiprow">
        <view class="chip cat {{item.poke ? 'poke' : ''}}">{{item.poke ? '破壳 · ' : ''}}{{item.aiTopic || item.eventType || item.cat}}</view>
        <view wx:if="{{item.platform}}" class="chip plat">{{item.platform}}</view>
        <view wx:if="{{item.room}}" class="chip">{{item.room}}</view>
      </view>
      <view class="type-hero detail-title">{{item.title}}</view>
      <view wx:if="{{item.gapReasonsFull.length}}" class="detail-reasons">
        <image class="seal-icon" src="/assets/seal-dot.svg" mode="aspectFit" />
        <view wx:for="{{item.gapReasonsFull}}" wx:key="*this" class="gapchip gap-1">{{item}}</view>
      </view>
    </view>

    <view class="detail-block detail-enter d1">
      <view class="detail-label">30 秒读懂</view>
      <view class="type-body detail-lede">{{item.detailLede}}</view>
      <view wx:if="{{item.highlights.length}}" class="detail-pills">
        <view wx:for="{{item.highlights}}" wx:key="*this" class="detail-pill">{{item}}</view>
      </view>
    </view>

    <view wx:if="{{item.whoFor.length}}" class="card-group detail-enter d2">
      <view class="sec-title">适合谁</view>
      <view class="card-inset detail-inset">
        <view wx:for="{{item.whoFor}}" wx:key="*this" class="detail-list-item">
          <text class="detail-bullet">·</text>
          <text>{{item}}</text>
        </view>
      </view>
    </view>

    <view wx:if="{{item.actions.length}}" class="card-group detail-enter d2">
      <view class="sec-title">要做什么</view>
      <view class="card-inset detail-inset">
        <view wx:for="{{item.actions}}" wx:key="*this" class="detail-list-item numbered">
          <text class="detail-num">{{index + 1}}</text>
          <text>{{item}}</text>
        </view>
      </view>
    </view>

    <view wx:if="{{item.caveats.length}}" class="detail-caveats detail-enter d3">
      <view class="detail-label">注意</view>
      <view wx:for="{{item.caveats}}" wx:key="*this" class="detail-caveat-item">{{item}}</view>
    </view>

    <view wx:if="{{item.insiderNote}}" class="insider detail-insider detail-enter d3">
      {{item.insiderNote}}<text class="insider-disclaimer"> · 个人体验，仅供参考</text>
    </view>

    <view wx:if="{{item.pokeReason}}" class="pokereason detail-enter d3">{{item.pokeReason}}</view>

    <view class="detail-fold detail-enter d4" bindtap="toggleRaw">
      <view class="detail-fold-hd">
        <text class="detail-label" style="margin:0">完整群消息</text>
        <text class="detail-fold-toggle">{{rawOpen ? '收起' : '展开'}}</text>
      </view>
      <view wx:if="{{rawOpen && item.rawText}}" class="detail-raw">{{item.rawText}}</view>
      <view wx:elif="{{!item.rawText}}" class="type-caption">暂无原文</view>
    </view>

    <view class="detail-fold detail-enter d4" bindtap="toggleMeta">
      <view class="detail-fold-hd">
        <text class="detail-label" style="margin:0">AI 整理依据</text>
        <text class="detail-fold-toggle">{{metaOpen ? '收起' : '展开'}}</text>
      </view>
      <view wx:if="{{metaOpen}}" class="detail-meta-card" style="margin-top:16rpx;margin-bottom:0">
        <view wx:if="{{item.engine}}" class="detail-meta-row">
          <text class="detail-meta-k">引擎</text>
          <text class="detail-meta-v">{{item.engine === 'llm' ? 'DeepSeek' : '规则引擎'}}</text>
        </view>
        <view wx:if="{{item.confidence}}" class="detail-meta-row">
          <text class="detail-meta-k">置信度</text>
          <text class="detail-meta-v">{{item.confidence}}%</text>
        </view>
        <view wx:if="{{item.createdAt}}" class="detail-meta-row">
          <text class="detail-meta-k">收录</text>
          <text class="detail-meta-v">{{item.createdAt}}</text>
        </view>
        <view wx:if="{{item.time}}" class="detail-meta-row">
          <text class="detail-meta-k">时间</text>
          <text class="detail-meta-v">{{item.time}}</text>
        </view>
        <view wx:if="{{item.place}}" class="detail-meta-row">
          <text class="detail-meta-k">地点</text>
          <text class="detail-meta-v">{{item.place}}</text>
        </view>
        <view wx:if="{{item.stars}}" class="detail-meta-row">
          <text class="detail-meta-k">热度</text>
          <text class="detail-meta-v">⭐ {{item.stars}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="detail-sticky">
    <view wx:if="{{item.url}}" class="detail-sticky-primary" data-act="copylink" data-url="{{item.url}}" bindtap="onCopyLink">复制原文链接</view>
    <view class="detail-sticky-row">
      <view wx:if="{{item.rawText}}" class="detail-sticky-ghost" bindtap="onCopyRaw">复制原文</view>
      <view class="detail-sticky-ghost" bindtap="onShare">生成分享图</view>
    </view>
  </view>
</view>

<view wx:elif="{{missing}}" class="empty wrap">
  <view class="detail-nav" style="padding-top:{{statusBarHeight}}px">
    <view class="detail-nav-back" bindtap="onBack">‹ 返回</view>
  </view>
  <image class="empty-img" src="/assets/empty-signal.svg" mode="aspectFit" />
  <view class="empty-title">找不到这条信息</view>
  <view class="small">可能已过期，请返回列表刷新后再试</view>
</view>

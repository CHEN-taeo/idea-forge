<import src="../../templates/card.wxml" />

<view class="wrap">
  <view class="lead">🎯 <text class="em">活动雷达</text>：讲座 / 竞赛 / 展览 / 峰会 — 带信息差排序与截止提醒。</view>

  <view class="filterbar">
    <picker mode="selector" range="{{filters}}" value="{{filterIndex}}" bindchange="onFilter">
      <view class="filterpick">筛选：{{filters[filterIndex]}} ▾</view>
    </picker>
  </view>

  <block wx:if="{{gapItems.length}}">
    <view class="sec-title"><text class="n">!</text> 你可能漏掉的</view>
    <block wx:for="{{gapItems}}" wx:key="id">
      <template is="card" data="{{c: item}}" />
    </block>
  </block>

  <view class="sec-title"><text class="n">{{items.length}}</text> 全部机会</view>
  <block wx:if="{{items.length}}">
    <block wx:for="{{items}}" wx:key="id">
      <template is="card" data="{{c: item}}" />
    </block>
  </block>
  <view wx:else class="empty">
    <view class="big">🎯</view>{{online ? '暂无匹配活动' : '未连接后端'}}
    <view class="small">{{online ? '粘贴班委群/峰会海报到「导入」，或等待官网采集' : '启动 poke-server 后下拉刷新'}}</view>
  </view>
</view>

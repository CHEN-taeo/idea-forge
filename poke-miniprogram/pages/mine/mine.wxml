<import src="../../templates/hero.wxml" />

<template is="hero" data="{{heroData}}" />

<view class="wrap tabpage">
  <view class="sec-title" style="margin-top:0">校园关注</view>
  <view class="lead" style="margin-top:0;margin-bottom:20rpx">勾选后，「机会」里与你相关的会排更前</view>
  <view class="chiprow interestrow">
    <view wx:for="{{interestOpts}}" wx:key="*this"
      class="chip interest {{interests.indexOf(item) >= 0 ? 'on' : ''}}"
      data-key="{{item}}" bindtap="toggleInterest">{{item}}</view>
  </view>

  <view class="sec-title">AI 关注</view>
  <view class="lead" style="margin-top:0;margin-bottom:20rpx">影响「AI脉动」排序</view>
  <view class="chiprow interestrow">
    <view wx:for="{{aiInterestOpts}}" wx:key="*this"
      class="chip interest ai {{aiInterests.indexOf(item) >= 0 ? 'on' : ''}}"
      data-key="{{item}}" bindtap="toggleAiInterest">{{item}}</view>
  </view>

  <view class="ghost" bindtap="goForward">导入群消息 / 海报</view>
  <view wx:if="{{online}}" class="ghost" style="margin-top:16rpx" bindtap="goInsider">运营内幕标注</view>

  <view class="foot-note">为东华同学优化 · 只做信息收集与整理</view>
</view>

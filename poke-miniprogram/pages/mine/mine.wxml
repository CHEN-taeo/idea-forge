<import src="../../templates/card.wxml" />

<view class="wrap">
  <view class="sec-title" style="margin-left:0">我的关注（影响信息差排序）</view>
  <view class="chiprow interestrow">
    <view wx:for="{{interestOpts}}" wx:key="*this"
      class="chip interest {{interests.indexOf(item) >= 0 ? 'on' : ''}}"
      data-key="{{item}}" bindtap="toggleInterest">{{item}}</view>
  </view>

  <view wx:if="{{online}}" class="ghost" style="margin-bottom:24rpx" bindtap="goInsider">💎 运营内幕标注 →</view>

  <block wx:if="{{items.length}}">
    <view class="lead">你<text class="em">主动选</text>的事都在这 — 信息是用来<text class="em">行动</text>的。</view>
    <block wx:for="{{items}}" wx:key="id">
      <template is="card" data="{{c: item}}" />
    </block>
  </block>
  <view wx:else class="empty">
    <view class="big">📌</view>还没有标记任何事
    <view class="small">在「今天」里点「想去」或「找搭子」，会出现在这里</view>
  </view>
</view>

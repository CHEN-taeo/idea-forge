<view class="tabbar">
  <scroll-view scroll-x class="tabscroll" enable-flex>
    <view class="tabinner">
      <view
        wx:for="{{list}}"
        wx:key="pagePath"
        class="tab {{selected === index ? 'on' : ''}}"
        data-index="{{index}}"
        bindtap="switchTab"
      >
        <text class="icon">{{item.icon}}</text>
        <text class="txt">{{item.text}}</text>
      </view>
    </view>
  </scroll-view>
</view>

.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 99;
  background: rgba(255, 255, 255, 0.88);
  border-top: 1rpx solid rgba(60, 60, 67, 0.08);
  box-shadow: var(--shadow-tab, 0 -1rpx 0 rgba(60, 60, 67, 0.08));
}
.tabinner {
  display: flex;
  flex-direction: row;
  align-items: flex-end;
  min-height: 100rpx;
  padding: 6rpx 16rpx 10rpx;
}
.tab {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 10rpx 4rpx 12rpx;
  color: rgba(60, 60, 67, 0.45);
  position: relative;
  min-height: 80rpx;
  transition: color 180ms ease;
}
.tab.on { color: #5B8DEF; font-weight: 600; }
.tab-add { flex: 0 0 108rpx; padding-bottom: 4rpx; }
.add-btn {
  width: 92rpx;
  height: 92rpx;
  border-radius: 50%;
  background: linear-gradient(145deg, #6B9FFF 0%, #5B8DEF 100%);
  color: #fff;
  font-size: 44rpx;
  font-weight: 300;
  line-height: 92rpx;
  text-align: center;
  box-shadow: 0 8rpx 24rpx rgba(91, 141, 239, 0.35);
  margin-top: -24rpx;
}
.icon {
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1;
  margin-bottom: 4rpx;
}
.txt { font-size: 20rpx; line-height: 1.2; }

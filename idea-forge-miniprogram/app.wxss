page {
  --canvas: #faf9f5;
  --surface: #f5f0e8;
  --card: #efe9de;
  --card-strong: #e8e0d2;
  --ink: #141413;
  --ink-soft: #3d3d3a;
  --muted: #6c6a64;
  --muted-soft: #9c958a;
  --line: #e6dfd8;
  --accent: #c4673a;
  --accent-soft: rgba(196, 103, 58, 0.12);
  --dark: #181715;
  --dark-elevated: #252320;
  --radius: 20rpx;
  --radius-lg: 28rpx;
  --space: 32rpx;

  background: var(--canvas);
  color: var(--ink);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
}

view, text, input, textarea { box-sizing: border-box; }

/* Reset native button — avoid ghost borders & tap bugs */
button {
  margin: 0;
  padding: 0;
  background: transparent;
  border: none;
  border-radius: 0;
  line-height: normal;
  font-size: inherit;
}
button::after { border: none; }

.page {
  min-height: 100vh;
  padding: var(--space);
  padding-bottom: calc(var(--space) + env(safe-area-inset-bottom));
}

.page--chat {
  display: flex;
  flex-direction: column;
  height: 100vh;
  padding: 0;
  padding-bottom: env(safe-area-inset-bottom);
  overflow: hidden;
}

/* Typography */
.display {
  font-family: Georgia, "Times New Roman", "Songti SC", serif;
  font-weight: 400;
  letter-spacing: -0.02em;
  color: var(--ink);
}
.eyebrow {
  font-size: 22rpx;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--muted-soft);
}
.lead { font-size: 26rpx; color: var(--muted); line-height: 1.7; }

/* Cards */
.card {
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: var(--radius-lg);
  padding: 36rpx;
  margin-bottom: 24rpx;
}
.card--flat { background: var(--surface); }
.card--dark {
  background: var(--dark);
  border-color: rgba(255,255,255,0.08);
  color: #faf9f5;
}
.card--dark .lead { color: rgba(250,249,245,0.55); }

/* Hero */
.hero {
  text-align: center;
  padding: 48rpx 24rpx 40rpx;
  margin-bottom: 8rpx;
}
.mark {
  width: 88rpx; height: 88rpx;
  margin: 0 auto 28rpx;
  border-radius: 22rpx;
  background: var(--accent-soft);
  border: 1rpx solid rgba(196,103,58,0.22);
  display: flex; align-items: center; justify-content: center;
  font-size: 40rpx;
}
.hero-title {
  font-family: Georgia, "Times New Roman", "Songti SC", serif;
  font-size: 44rpx;
  color: var(--ink);
  margin-bottom: 8rpx;
}
.hero-sub { font-size: 24rpx; color: var(--muted); }

/* Status pill */
.status-pill {
  display: inline-flex;
  align-items: center;
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  background: var(--surface);
  border: 1rpx solid var(--line);
  font-size: 22rpx;
  color: var(--muted);
  margin-top: 24rpx;
}
.dot {
  width: 12rpx; height: 12rpx; border-radius: 50%;
  margin-right: 10rpx; flex-shrink: 0;
}
.dot--ok { background: #2d6a4f; }
.dot--wait { background: #c4673a; }
.dot--bad { background: #9b2226; }

/* Mode tiles — tappable rows, not stacked buttons */
.mode-list { margin-top: 8rpx; }
.mode-tile {
  display: flex;
  align-items: center;
  padding: 28rpx 28rpx;
  margin-bottom: 16rpx;
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: var(--radius-lg);
}
.mode-tile:active { background: var(--card-strong); }
.mode-tile--featured {
  background: var(--dark);
  border-color: rgba(255,255,255,0.1);
}
.mode-tile--featured .mode-title { color: #faf9f5; }
.mode-tile--featured .mode-desc { color: rgba(250,249,245,0.5); }
.mode-tile--disabled { opacity: 0.45; }
.mode-icon {
  width: 72rpx; height: 72rpx;
  border-radius: 18rpx;
  background: var(--surface);
  border: 1rpx solid var(--line);
  display: flex; align-items: center; justify-content: center;
  font-size: 34rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
}
.mode-tile--featured .mode-icon {
  background: rgba(255,255,255,0.06);
  border-color: rgba(255,255,255,0.1);
}
.mode-body { flex: 1; min-width: 0; }
.mode-title { font-size: 30rpx; color: var(--ink); font-weight: 500; }
.mode-desc { font-size: 22rpx; color: var(--muted); margin-top: 6rpx; line-height: 1.5; }
.mode-arrow { font-size: 28rpx; color: var(--muted-soft); margin-left: 12rpx; }

/* Tap targets (prefer over native button) */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: 96rpx;
  padding: 24rpx 32rpx;
  border-radius: var(--radius-lg);
  font-size: 28rpx;
  font-weight: 500;
  margin-bottom: 16rpx;
}
.btn:active { opacity: 0.88; }
.btn--primary {
  background: var(--accent);
  color: #fff;
}
.btn--secondary {
  background: var(--surface);
  border: 1rpx solid var(--line);
  color: var(--ink-soft);
}
.btn--ghost {
  background: transparent;
  border: 1rpx solid var(--line);
  color: var(--muted);
}
.btn--dark {
  background: var(--dark);
  color: #faf9f5;
}
.btn--text {
  min-height: 72rpx;
  background: transparent;
  color: var(--muted);
  font-size: 26rpx;
  font-weight: 400;
}
.btn--sm { min-height: 72rpx; font-size: 26rpx; padding: 16rpx 24rpx; }
.btn--disabled { opacity: 0.4; pointer-events: none; }

/* Form */
.field { margin-bottom: 28rpx; }
.field-label {
  display: block;
  font-size: 22rpx;
  letter-spacing: 0.08em;
  color: var(--muted);
  margin-bottom: 12rpx;
}
.field-input, .field-textarea {
  width: 100%;
  background: #fff;
  border: 1rpx solid var(--line);
  border-radius: var(--radius);
  color: var(--ink);
  padding: 22rpx 24rpx;
  font-size: 28rpx;
}
.field-textarea { min-height: 180rpx; }

/* Chips */
.chip-row { display: flex; flex-wrap: wrap; gap: 12rpx; margin: 16rpx 0; }
.chip {
  padding: 12rpx 22rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  background: var(--surface);
  border: 1rpx solid var(--line);
  color: var(--muted);
}
.chip--on {
  background: var(--accent-soft);
  border-color: rgba(196,103,58,0.35);
  color: var(--accent);
}

/* Persona pick */
.persona-item {
  display: flex;
  align-items: flex-start;
  padding: 24rpx;
  margin-bottom: 12rpx;
  background: #fff;
  border: 2rpx solid var(--line);
  border-radius: var(--radius-lg);
}
.persona-item--on {
  border-color: var(--accent);
  background: var(--accent-soft);
}
.persona-emoji { font-size: 36rpx; margin-right: 20rpx; line-height: 1.2; }
.persona-name { font-size: 28rpx; color: var(--ink); font-weight: 500; }
.persona-meta { font-size: 22rpx; color: var(--muted); margin-top: 4rpx; }
.persona-check { margin-left: auto; color: var(--accent); font-size: 24rpx; }

/* Chat layout */
.chat-header {
  flex-shrink: 0;
  padding: 24rpx var(--space) 20rpx;
  background: var(--canvas);
  border-bottom: 1rpx solid var(--line);
}
.chat-scroll {
  flex: 1;
  height: 0;
  padding: 24rpx var(--space);
}
.chat-composer {
  flex-shrink: 0;
  padding: 16rpx var(--space) calc(16rpx + env(safe-area-inset-bottom));
  background: var(--surface);
  border-top: 1rpx solid var(--line);
}
.composer-row { display: flex; align-items: flex-end; gap: 16rpx; }
.composer-input {
  flex: 1;
  min-height: 80rpx;
  max-height: 200rpx;
  background: #fff;
  border: 1rpx solid var(--line);
  border-radius: var(--radius);
  padding: 18rpx 22rpx;
  font-size: 28rpx;
}
.composer-send {
  flex-shrink: 0;
  width: 128rpx;
  min-height: 80rpx;
  margin-bottom: 0;
}

.bubble {
  max-width: 86%;
  padding: 20rpx 24rpx;
  border-radius: 24rpx;
  margin-bottom: 20rpx;
  font-size: 28rpx;
  line-height: 1.65;
  border: 1rpx solid var(--line);
  background: #fff;
  color: var(--ink-soft);
}
.bubble--me {
  margin-left: auto;
  background: var(--accent-soft);
  border-color: rgba(196,103,58,0.25);
}
.bubble-name { font-size: 22rpx; color: var(--muted-soft); margin-bottom: 8rpx; display: block; }

.starter-btn {
  text-align: left;
  padding: 22rpx 24rpx;
  margin-bottom: 12rpx;
  background: #fff;
  border: 1rpx solid var(--line);
  border-radius: var(--radius);
  font-size: 26rpx;
  color: var(--ink-soft);
}
.starter-btn:active { background: var(--surface); }

.room-code {
  font-family: Georgia, serif;
  font-size: 72rpx;
  letter-spacing: 0.18em;
  text-align: center;
  color: var(--ink);
  margin: 24rpx 0;
}

.inspiration-scroll { white-space: nowrap; margin: 16rpx 0 24rpx; }
.inspiration-chip {
  display: inline-block;
  vertical-align: top;
  max-width: 420rpx;
  white-space: normal;
  margin-right: 12rpx;
  padding: 16rpx 20rpx;
  border-radius: var(--radius);
  font-size: 24rpx;
  background: var(--surface);
  border: 2rpx solid var(--line);
  color: var(--muted);
}
.inspiration-chip--on {
  border-color: var(--accent);
  background: var(--accent-soft);
  color: var(--accent);
}

.idea-row {
  padding: 24rpx;
  margin-bottom: 12rpx;
  background: #fff;
  border: 2rpx solid var(--line);
  border-radius: var(--radius);
  font-size: 28rpx;
  color: var(--ink-soft);
}
.idea-row--on {
  border-color: var(--accent);
  background: var(--accent-soft);
}

.section-gap { height: 24rpx; }

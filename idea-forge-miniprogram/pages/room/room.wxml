<view class="page" wx:if="{{gameState}}">
  <view class="room-header">
    <view class="status-pill">
      <view class="dot {{connectionStatus === 'connected' ? 'dot--ok' : 'dot--bad'}}"></view>
      {{roomCode}} · {{phaseLabel}}
    </view>
    <view wx:if="{{timerDisplay}}" class="timer {{timerUrgent ? 'timer--urgent' : ''}}">{{timerDisplay}}</view>
  </view>
  <view class="lead problem-lead">{{gameState.problemStatement}}</view>

  <!-- LOBBY -->
  <block wx:if="{{gameState.phase === 'lobby'}}">
    <view class="card card--center">
      <block wx:if="{{isHost}}">
        <view class="lead">大屏打开网页版投屏；参与者输入下方房间码</view>
        <view class="room-code">{{gameState.roomCode}}</view>
        <view class="btn btn--secondary btn--sm" bindtap="copyRoomCode">复制房间码</view>
      </block>
      <block wx:else>
        <view class="display">已加入</view>
        <view class="lead">等待主持人开始</view>
      </block>
      <view class="lead mt"> {{playerCount}} 人在线</view>
      <view wx:for="{{playersArray}}" wx:key="id" class="player-row">
        {{item.name}}{{item.ready ? ' · 已就绪' : ''}}
      </view>
    </view>
    <view class="btn btn--secondary" bindtap="toggleReady">{{ready ? '取消就绪' : '我准备好了'}}</view>
    <view wx:if="{{isHost}}" class="btn btn--primary" bindtap="startGame">开始围炉</view>
  </block>

  <!-- R1 SUBMIT -->
  <block wx:elif="{{gameState.phase === 'r1_submit'}}">
    <view wx:if="{{myRole}}" class="role-banner">
      <text class="role-banner__label">你的角色</text>
      <text class="role-banner__name">{{myRole}}</text>
    </view>
    <view class="card card--flat">
      <textarea class="field-textarea" placeholder="写下你的想法…" value="{{ideaText}}" bindinput="onIdeaInput" />
      <view class="field-label">选一张灵感卡</view>
      <scroll-view scroll-x class="inspiration-scroll" enable-flex>
        <view wx:for="{{inspirationCards}}" wx:key="*this" class="inspiration-chip {{selectedCard === index ? 'inspiration-chip--on' : ''}}" data-i="{{index}}" bindtap="pickCard">{{item}}</view>
      </scroll-view>
      <view class="btn btn--primary" bindtap="submitIdea">提交想法</view>
    </view>
    <view class="lead">已提交 {{gameState.ideas.length}} / {{playerCount}} 人</view>
    <view wx:if="{{isHost}}" class="btn btn--text" bindtap="nextPhase">主持人：进入竞猜 →</view>
  </block>

  <!-- R1 GUESS -->
  <block wx:elif="{{gameState.phase === 'r1_guess'}}">
    <view wx:for="{{guessCards}}" wx:key="id" class="card card--flat mb">
      <view class="idea-text">{{item.text}}</view>
      <view class="field-label">猜是谁写的？</view>
      <view wx:for="{{item.candidates}}" wx:for-item="pl" wx:key="id" class="btn btn--secondary btn--sm inline-btn" data-ideaid="{{item.id}}" data-authorid="{{pl.id}}" bindtap="pickGuess">{{pl.name}}</view>
    </view>
    <view wx:if="{{isHost}}" class="btn btn--primary" bindtap="nextPhase">主持人：下一轮 →</view>
  </block>

  <!-- R2 ADAPT -->
  <block wx:elif="{{gameState.phase === 'r2_adapt'}}">
    <view wx:if="{{myAdaptation}}" class="card card--flat mb">
      <view class="field-label">你的改造</view>
      <view class="idea-text">{{myAdaptation.text}}</view>
    </view>
    <block wx:else>
      <view class="field-label">选一条构想改造</view>
      <view wx:for="{{r2TopIdeas}}" wx:key="id" class="idea-pick {{selectedAdaptId === item.id ? 'idea-pick--on' : ''}}" data-id="{{item.id}}" bindtap="selectAdapt">
        <text class="idea-pick__votes">⬆ {{item.votes}}</text>
        <text>{{item.text}}</text>
      </view>
      <textarea class="field-textarea" placeholder="你的改造版本…" value="{{adaptText}}" bindinput="onAdaptInput" />
      <view class="btn btn--primary" bindtap="submitAdapt">提交改造</view>
    </block>
    <view wx:for="{{pendingEndorse}}" wx:key="id" class="card card--flat mb">
      <view class="field-label">待你认可</view>
      <view class="idea-text">{{item.text}}</view>
      <view class="btn btn--secondary btn--sm" data-id="{{item.id}}" bindtap="endorseAdapt">认可改造</view>
    </view>
    <view wx:if="{{isHost}}" class="btn btn--primary" bindtap="nextPhase">主持人：进入质询 →</view>
  </block>

  <!-- R3 CHALLENGE -->
  <block wx:elif="{{gameState.phase === 'r3_challenge'}}">
    <view class="tab-row">
      <view class="tab {{r3Tab === 'ideas' ? 'tab--on' : ''}}" data-tab="ideas" bindtap="setR3Tab">质询</view>
      <view class="tab {{r3Tab === 'defend' ? 'tab--on' : ''}}" data-tab="defend" bindtap="setR3Tab">辩护</view>
      <view class="tab {{r3Tab === 'vote' ? 'tab--on' : ''}}" data-tab="vote" bindtap="setR3Tab">表决</view>
    </view>

    <block wx:if="{{r3Tab === 'ideas'}}">
      <view wx:for="{{aliveIdeas}}" wx:key="id" class="card card--flat mb">
        <view class="idea-text">{{item.text}}</view>
        <block wx:if="{{item.authorId !== playerId && !item.challengedBy}}">
          <block wx:if="{{challengingId === item.id}}">
            <textarea class="field-textarea field-textarea--sm" placeholder="质询理由…" value="{{challengeReason}}" bindinput="onChallengeInput" />
            <view class="btn btn--primary btn--sm" bindtap="submitChallenge">提交质询</view>
          </block>
          <view wx:else class="btn btn--secondary btn--sm" data-id="{{item.id}}" bindtap="startChallenge">质询这条</view>
        </block>
        <view wx:if="{{item.challengedBy}}" class="muted">已被质询</view>
      </view>
    </block>

    <block wx:elif="{{r3Tab === 'defend'}}">
      <view wx:if="{{myChallenged.length === 0}}" class="lead">暂无需要你辩护的构想</view>
      <view wx:for="{{myChallenged}}" wx:key="id" class="card card--flat mb">
        <view class="idea-text">{{item.text}}</view>
        <block wx:if="{{defendId === item.id}}">
          <view class="check-row" bindtap="toggleDefendAccept">
            <text>{{defendAccept ? '☑' : '☐'}} 接受质询并改进</text>
          </view>
          <textarea wx:if="{{!defendAccept}}" class="field-textarea field-textarea--sm" placeholder="辩护回应…" value="{{defendText}}" bindinput="onDefendInput" />
          <view class="btn btn--primary btn--sm" bindtap="submitDefend">提交辩护</view>
        </block>
        <view wx:else class="btn btn--secondary btn--sm" data-id="{{item.id}}" bindtap="startDefend">开始辩护</view>
      </view>
    </block>

    <block wx:else>
      <view wx:if="{{defensesToVote.length === 0}}" class="lead">暂无待表决的辩护</view>
      <view wx:for="{{defensesToVote}}" wx:key="id" class="card card--flat mb">
        <view class="idea-text">{{item.text}}</view>
        <view class="muted">回应：{{item.defenseResponse}}</view>
        <view class="btn-row">
          <view class="btn btn--primary btn--sm" data-id="{{item.id}}" data-ok="1" bindtap="voteDefense">辩护成功</view>
          <view class="btn btn--danger btn--sm" data-id="{{item.id}}" data-ok="0" bindtap="voteDefense">辩护失败</view>
        </view>
      </view>
    </block>
    <view wx:if="{{isHost}}" class="btn btn--primary" bindtap="nextPhase">主持人：进入承诺仪式 →</view>
  </block>

  <!-- COMMITMENT -->
  <block wx:elif="{{gameState.phase === 'commitment'}}">
    <view class="ceremony-header">
      <text class="ceremony-title">☯ 承诺仪式</text>
      <text class="ceremony-sub">{{commitments.length}} / {{playerCount}} 人已认领</text>
    </view>
    <block wx:if="{{myCommitted}}">
      <view class="card card--flat card--center">
        <view class="display">你已认领</view>
        <view class="lead">等待其他人完成认领</view>
      </view>
    </block>
    <block wx:else>
      <scroll-view scroll-x class="commit-scroll" enable-flex>
        <view wx:for="{{topIdeas}}" wx:key="id" class="commit-chip {{selectedCommitIdeaId === item.id ? 'commit-chip--on' : ''}} {{item.claimed ? 'commit-chip--claimed' : ''}}" data-id="{{item.id}}" data-claimed="{{item.claimed ? '1' : '0'}}" bindtap="selectCommitIdea">
          <text class="commit-chip__votes">⬆ {{item.votes}}</text>
          <text class="commit-chip__text">{{item.text}}</text>
        </view>
      </scroll-view>
      <view wx:if="{{selectedCommitIdeaId}}" class="card card--flat">
        <view class="field-label">我承诺要做（至少 8 字）</view>
        <textarea class="field-textarea" placeholder="具体、可执行的一件事…" value="{{smartWhat}}" bindinput="onSmartWhatInput" />
        <view class="field-label">完成期限</view>
        <view class="due-row">
          <view wx:for="{{dueDayOptions}}" wx:key="*this" class="due-chip {{dueDays === item ? 'due-chip--on' : ''}}" data-d="{{item}}" bindtap="pickDueDays">{{item}} 天</view>
        </view>
        <view wx:if="{{previewAction}}" class="preview-box">{{previewAction}}</view>
        <view class="btn btn--text btn--sm" bindtap="aiSuggestCommit">{{aiLoading ? 'AI 思考中…' : '🤖 AI 帮我写行动'}}</view>
        <view class="btn btn--primary" bindtap="submitCommitment">{{commitSubmitting ? '认领中…' : '✍️ 认领承诺'}}</view>
      </view>
    </block>
    <view wx:for="{{commitments}}" wx:key="id" class="commit-row">
      <text class="commit-row__who">{{item.playerName}}</text>
      <text class="commit-row__what">{{item.action}}</text>
    </view>
    <view wx:if="{{isHost}}" class="btn btn--primary" bindtap="nextPhase">主持人：结束会话 →</view>
  </block>

  <!-- FINISHED -->
  <block wx:elif="{{gameState.phase === 'finished'}}">
    <view class="card card--center">
      <view class="display">🎉 会话结束</view>
      <view class="lead">今日承诺</view>
    </view>
    <view wx:for="{{commitments}}" wx:key="id" class="card card--flat mb">
      <view class="commit-row__who">{{item.playerName}}</view>
      <view class="idea-text">{{item.action}}</view>
      <view wx:if="{{item.dueDate}}" class="muted">截止 {{item.dueDate}}</view>
    </view>
  </block>

  <view class="btn btn--text leave-btn" bindtap="leaveRoom">离开房间</view>
</view>

<view class="page" wx:else>
  <view class="card card--flat card--center pad-lg">
    <view class="dot dot--wait center-dot" wx:if="{{connectionStatus === 'connecting'}}"></view>
    <view class="dot dot--bad center-dot" wx:if="{{connectionStatus === 'error'}}"></view>
    <view class="lead" wx:if="{{connectionStatus === 'connecting'}}">连接房间中…</view>
    <block wx:elif="{{connectionStatus === 'error'}}">
      <view class="display display--sm">连接失败</view>
      <view class="lead mb">{{connectionError}}</view>
      <view class="btn btn--primary" bindtap="retryConnect">重试</view>
      <view class="btn btn--text" bindtap="leaveRoom">返回</view>
    </block>
  </view>
</view>

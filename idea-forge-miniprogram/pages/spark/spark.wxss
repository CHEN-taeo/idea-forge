.spark-tabs {
  display: flex;
  gap: 8rpx;
  padding: 8rpx;
  margin-bottom: 24rpx;
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: var(--radius-lg);
}
.spark-tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 26rpx;
  color: var(--muted);
  border-radius: 18rpx;
}
.spark-tab--on {
  background: var(--card);
  color: var(--ink);
  box-shadow: 0 1rpx 4rpx rgba(20, 20, 19, 0.06);
}

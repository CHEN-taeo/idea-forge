<view class="page">
  <view class="eyebrow" style="margin-bottom:12rpx;">发起围炉</view>
  <view class="display" style="font-size:40rpx;margin-bottom:8rpx;">设定今晚的问题</view>
  <view class="lead" style="margin-bottom:32rpx;">大屏投屏网页版，参与者用小程序加入。</view>

  <view class="card card--flat">
    <view class="field">
      <text class="field-label">你的名字</text>
      <input class="field-input" placeholder="例如：小陈" value="{{playerName}}" bindinput="onNameInput" />
    </view>
    <view class="field">
      <text class="field-label">讨论主题</text>
      <textarea class="field-textarea" placeholder="例如：Q3 产品方向怎么选？" value="{{problemStatement}}" bindinput="onProblemInput" maxlength="-1" />
    </view>
    <view class="field-label">围炉模式</view>
    <view class="chip-row">
      <view class="chip {{template === 'quick' ? 'chip--on' : ''}}" data-t="quick" bindtap="setTemplate">快速围炉</view>
      <view class="chip {{template === 'full' ? 'chip--on' : ''}}" data-t="full" bindtap="setTemplate">完整三轮</view>
    </view>
  </view>

  <view class="btn btn--primary {{submitting ? 'btn--disabled' : ''}}" bindtap="submit">创建并进入 →</view>
</view>

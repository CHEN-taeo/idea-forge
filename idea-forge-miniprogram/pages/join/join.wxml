<view class="page">
  <view class="eyebrow">加入围炉</view>
  <view class="display" style="font-size:40rpx;margin:12rpx 0 24rpx;">输入房间码</view>
  <view class="card card--flat">
    <view class="field">
      <text class="field-label">你的名字</text>
      <input class="field-input" placeholder="例如：小陈" value="{{playerName}}" bindinput="onNameInput" />
    </view>
    <view class="field">
      <text class="field-label">房间码</text>
      <input class="field-input" placeholder="6 位字母数字" value="{{roomCode}}" bindinput="onRoomInput" maxlength="6" />
    </view>
  </view>
  <view class="btn btn--primary {{submitting ? 'btn--disabled' : ''}}" bindtap="submit">加入房间</view>
</view>

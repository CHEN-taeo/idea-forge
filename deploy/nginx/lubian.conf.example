# 炉边 API · Nginx 反向代理示例
# 域名需已备案（微信小程序 request / socket 合法域名要求）
# 证书：可用 certbot / 云厂商免费证书
#
# 安装后：
#   sudo ln -s /path/to/lubian.conf /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx

upstream lubian_backend {
  server 127.0.0.1:3001;
  keepalive 32;
}

server {
  listen 80;
  server_name api.你的域名.com;
  return 301 https://$host$request_uri;
}

server {
  listen 443 ssl http2;
  server_name api.你的域名.com;

  ssl_certificate     /etc/nginx/ssl/fullchain.pem;
  ssl_certificate_key /etc/nginx/ssl/privkey.pem;

  client_max_body_size 2m;

  # REST + 静态 SPA
  location / {
    proxy_pass http://lubian_backend;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  # Socket.IO（微信小程序 socket 合法域名填 wss://api.你的域名.com）
  location /socket.io/ {
    proxy_pass http://lubian_backend;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 86400s;
    proxy_send_timeout 86400s;
  }
}

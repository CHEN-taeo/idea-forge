# 炉边 · 生产环境变量（复制为仓库根目录 .env 后填入真值）
# 部署到云服务器 / Docker 时使用

NODE_ENV=production
PORT=3001
HOST=0.0.0.0

# 必填：OpenAI 兼容 API（名士围炉 / 入炉 AI 功能）
AI_API_KEY=
AI_API_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat

# 品牌（Web 构建与导出页脚）
VITE_BRAND_PRODUCT=炉边
VITE_BRAND_HOST_NAME=陈老师
VITE_BRAND_SLOGAN=话在炉边，事有着落。
VITE_BRAND_SUBTITLE=夜话不尽，离场有契。

# 可选
BRAND_COACH_NAME=陈老师

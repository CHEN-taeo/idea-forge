# Idea Forge — copy to .env and adjust
# Used by: npm run server (node --env-file=.env server.js)

# Server
PORT=3001
HOST=0.0.0.0
NODE_ENV=development
DB_PATH=ideaforge.db

# Vite dev client → backend (also baked at build time for production)
VITE_SERVER_URL=http://localhost:3001

# AI (OpenAI-compatible; leave empty for Chinese template fallback)
AI_API_KEY=
AI_API_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat

# Brand — server coach name + Vite client strings
BRAND_COACH_NAME=陈老师
VITE_BRAND_PRODUCT=炉边
VITE_BRAND_HOST_NAME=陈老师
VITE_BRAND_SLOGAN=话在炉边，事有着落。
VITE_BRAND_SUBTITLE=夜话不尽，离场有契。
VITE_BRAND_SOLO=独酌
VITE_BRAND_ROOM=围炉
VITE_BRAND_SPARK=拾念
VITE_BRAND_ROUNDTABLE=名士围炉
